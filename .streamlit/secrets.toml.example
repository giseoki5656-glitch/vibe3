# 이 파일을 secrets.toml 로 복사해서 사용하세요. (secrets.toml 은 git 에 올리지 않습니다)

# 로컬 개발: 생략하면 sqlite:///local.db 사용
# 배포: 외부 PostgreSQL 접속 URL
# DATABASE_URL = "postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME"

# 최초 관리자 계정 (앱 시작 시 없으면 생성)
[admin]
username = "admin"
name = "관리자"
password = "change-me-please"

# 파일 저장소 (v1 단계 2에서 사용). 로컬 개발은 local, 배포는 외부 스토리지
[storage]
backend = "local"
local_dir = "local_uploads"
